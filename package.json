{
  "name": "nestjs-bustransit",
  "version": "0.4.0",
  "description": "Production-ready NestJS message bus with RabbitMQ, featuring Saga Pattern with persistence (MongoDB/PostgreSQL), Routing Slips orchestration, and comprehensive retry strategies for reliable distributed systems",
  "author": "nguyen2242x@gmail.com",
  "license": "MIT",
  "repository": "diepnghitinh/nestjs-bustransit",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "precommit": "lint-staged",
    "prepare": "npm run build",
    "prepublish:next": "npm run build",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:next": "npm publish --access public --tag next",
    "prerelease": "npm run build",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "keywords": [
    "nestjs",
    "service-bus",
    "message-bus",
    "rabbitmq",
    "saga",
    "saga-pattern",
    "routing-slips",
    "distributed-transactions",
    "microservices",
    "event-driven",
    "compensation",
    "retry-strategies",
    "mongodb",
    "postgresql",
    "state-machine",
    "orchestration",
    "choreography",
    "resilience"
  ],
  "dependencies": {
    "@nestjs/class-transformer": "^0.4.0",
    "@nestjs/class-validator": "^0.13.4",
    "amqplib": "^0.10.7",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^11.1.2",
    "@types/node": "^20.3.1",
    "@types/amqplib": "^0.10.7",
    "typescript": "^5.1.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.12",
    "reflect-metadata": "^0.2.2",
    "mongoose": "^9.0.2",
    "typeorm": "^0.3.28"
  }
}